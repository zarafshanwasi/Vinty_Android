<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">

    <!-- Gradient Fill -->
    <gradient
        android:startColor="#E98700"
        android:endColor="#F9C701"
        android:angle="90" />

    <!-- Border -->
    <stroke
        android:width="1dp"
        android:color="#4D138E" />

    <!-- Rounded Corners -->
    <corners android:radius="16dp" />

</shape>
