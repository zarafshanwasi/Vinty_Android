<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- First color: 390577 with 100% opacity -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#FF390577"/>
            <corners android:radius="10dp" />
        </shape>
    </item>

    <!-- Second color: F7BF00 with 10% opacity -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#1AF7BF00"/>
            <corners android:radius="10dp" />
        </shape>
    </item>

    <!-- Outer border: F7BF00 with 1dp width -->
    <item>
        <shape android:shape="rectangle">
            <stroke
                android:width="1dp"
                android:color="#FFF7BF00" />
            <corners android:radius="10dp" />
        </shape>
    </item>
</layer-list>