<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <item>
        <shape android:shape="oval">
            <size
                android:width="110dp"
                android:height="110dp" />
            <gradient
                android:type="radial"
                android:gradientRadius="55dp"
                android:centerX="0.5"
                android:centerY="0.5"
                android:startColor="#26FFC801"
                android:endColor="#00FFC801" />
        </shape>
    </item>

    <item>
        <shape android:shape="oval">
            <size
                android:width="80dp"
                android:height="80dp" />
            <gradient
                android:type="radial"
                android:gradientRadius="40dp"
                android:centerX="0.5"
                android:centerY="0.5"
                android:startColor="#4DFFC801"
                android:endColor="#00FFC801" />
        </shape>
    </item>

</layer-list>
