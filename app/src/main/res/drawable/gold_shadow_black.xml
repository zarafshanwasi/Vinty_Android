<?xml version="1.0" encoding="utf-8"?>
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">

    <!-- Linear Gradient Fill -->
    <gradient
        android:startColor="#F9C701"
        android:endColor="#E98700"
        android:angle="90" />

    <!-- Rounded Corners -->
    <corners android:radius="99dp" />

    <!-- Subtle shadow (simulated via padding + shadowColor) -->
    <padding
        android:left="4dp"
        android:top="4dp"
        android:right="4dp"
        android:bottom="4dp" />

    <shadowColor android:color="#40000000" /> <!-- 25% black shadow -->
</shape>
