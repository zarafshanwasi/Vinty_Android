<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- OUTER GRADIENT BORDER (6dp) -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="20dp" />
            <gradient
                android:startColor="#E98700"
                android:endColor="#F9C701"
                android:angle="90" />
        </shape>
    </item>

    <!-- INNER BORDER + FILL -->
    <item
        android:left="8dp"
        android:top="8dp"
        android:right="8dp"
        android:bottom="8dp">

        <shape android:shape="rectangle">
            <corners android:radius="20dp" />

            <!-- Inner border -->
            <stroke
                android:width="2dp"
                android:color="#4D138E" />

            <!-- Inside color -->
            <solid android:color="#390577" />
        </shape>
    </item>

</layer-list>
