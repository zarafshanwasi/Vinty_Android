<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="6dp">

    <View
        android:id="@+id/gift_card"
        android:layout_width="0dp"
        android:layout_height="220dp"
        android:background="@drawable/bg_box_gift"/>

    <View
        android:id="@+id/view31"
        android:layout_width="0dp"
        android:layout_height="96dp"
        android:background="@drawable/bg_box_gift_2"
        app:layout_constraintEnd_toEndOf="@+id/gift_card"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="@+id/gift_card"
        app:layout_constraintTop_toTopOf="@+id/gift_card" />

    <ImageView
        android:id="@+id/dollar_image"
        android:layout_width="0dp"
        android:layout_height="68dp"
        android:layout_marginStart="30dp"
        android:layout_marginEnd="30dp"
        app:layout_constraintBottom_toBottomOf="@+id/view31"
        app:layout_constraintEnd_toEndOf="@+id/view31"
        app:layout_constraintHorizontal_bias="0.494"
        app:layout_constraintStart_toStartOf="@+id/view31"
        app:layout_constraintTop_toTopOf="@+id/gift_card"
        app:srcCompat="@drawable/dollar_icon10" />

    <TextView
        android:id="@+id/description_giftcard"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_marginTop="10dp"
        android:fontFamily="@font/poppins_semibold"
        android:text="$10 Gift Card"
        android:textColor="@color/white"
        app:layout_constraintStart_toStartOf="@+id/view31"
        app:layout_constraintTop_toBottomOf="@+id/view31" />

    <TextView
        android:id="@+id/value_txtview"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:fontFamily="@font/poppins_medium"
        android:text="Use this $10 card across\n multiple platforms"
        android:textColor="#C7C7C7"
        android:textSize="10sp"
        app:layout_constraintStart_toStartOf="@+id/description_giftcard"
        app:layout_constraintTop_toBottomOf="@+id/description_giftcard" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnContinue"
        android:layout_width="0dp"
        android:layout_height="38dp"
        android:layout_marginEnd="10dp"
        android:textColor="@color/white"
        android:textSize="12sp"
        app:backgroundTint="@color/btn_color"
        app:cornerRadius="15dp"
        app:layout_constraintBottom_toBottomOf="@+id/gift_card"
        app:layout_constraintEnd_toEndOf="@+id/gift_card"
        app:layout_constraintStart_toStartOf="@+id/value_txtview"
        app:layout_constraintTop_toBottomOf="@+id/value_txtview" />

    <TextView
        android:id="@+id/textView39"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="6dp"
        android:fontFamily="@font/poppins_medium"
        android:text="Need"
        android:textColor="@color/white"
        android:textSize="11.8sp"
        app:layout_constraintBottom_toBottomOf="@+id/btnContinue"
        app:layout_constraintEnd_toStartOf="@+id/imageView28"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toStartOf="@+id/btnContinue"
        app:layout_constraintTop_toTopOf="@+id/btnContinue" />

    <ImageView
        android:id="@+id/imageView28"
        android:layout_width="15dp"
        android:layout_height="12dp"
        android:layout_marginStart="4dp"
        android:layout_marginEnd="2dp"
        app:layout_constraintBottom_toBottomOf="@+id/textView39"
        app:layout_constraintEnd_toStartOf="@+id/amount_txt_view"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toEndOf="@+id/textView39"
        app:layout_constraintTop_toTopOf="@+id/textView39"
        app:srcCompat="@drawable/ticket_icon" />

    <TextView
        android:id="@+id/amount_txt_view"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="6dp"
        android:fontFamily="@font/poppins_medium"
        android:text="22000 to claim"
        android:textColor="@color/white"
        android:textSize="11.8sp"
        app:layout_constraintBottom_toBottomOf="@+id/imageView28"
        app:layout_constraintEnd_toEndOf="@+id/btnContinue"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toEndOf="@+id/imageView28"
        app:layout_constraintTop_toTopOf="@+id/imageView28" />



</androidx.constraintlayout.widget.ConstraintLayout>